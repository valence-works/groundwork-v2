<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GroundworkVersion Condition="'$(GroundworkVersion)' == ''">0.4.0-preview.13</GroundworkVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PublicApiApprovalFixture.cs" />
    <PackageReference Include="Groundwork.Kernel" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Store" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Substrate.Relational" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Records" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Records.Store" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Schema" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Query.Planning" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Query.Linq.Execution" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Sqlite" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.MySql" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Documents" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.EntityFrameworkCore" Version="$(GroundworkVersion)" />
    <PackageReference Include="Groundwork.Testing" Version="$(GroundworkVersion)" />
  </ItemGroup>
</Project>
