<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This consumer is copied outside the repository and restored only from packed artifacts.
         A package boundary proves what customers receive and prevents PublishAot from becoming a
         global property on the portable netstandard2.0 source projects. -->
    <PackageReference Include="Groundwork.Testing" Version="$(GroundworkVersion)" />
  </ItemGroup>

</Project>
