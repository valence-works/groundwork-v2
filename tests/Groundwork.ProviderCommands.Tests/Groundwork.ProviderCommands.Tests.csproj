  <ItemGroup>
    <ProjectReference Include="../../src/Groundwork.PostgreSql/Groundwork.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Groundwork.Sqlite/Groundwork.Sqlite.csproj" />
    <ProjectReference Include="../../src/Groundwork.SqlServer/Groundwork.SqlServer.csproj" />
    <ProjectReference Include="../../src/Groundwork.MongoDb/Groundwork.MongoDb.csproj" />
