<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../../src/Groundwork.Testing/Groundwork.Testing.csproj" />
    <ProjectReference Include="../../src/Groundwork.Sqlite/Groundwork.Sqlite.csproj" />
    <ProjectReference Include="../../src/Groundwork.PostgreSql/Groundwork.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Groundwork.SqlServer/Groundwork.SqlServer.csproj" />
    <ProjectReference Include="../../src/Groundwork.MongoDb/Groundwork.MongoDb.csproj" />
    <ProjectReference Include="../../src/Groundwork.Query.Linq/Groundwork.Query.Linq.csproj" />
    <ProjectReference Include="../../src/Groundwork.Query.Linq.Sqlite/Groundwork.Query.Linq.Sqlite.csproj" />
    <ProjectReference Include="../../src/Groundwork.Records/Groundwork.Records.csproj" />
    <ProjectReference Include="../../src/Groundwork.Schema/Groundwork.Schema.csproj"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="../../src/Groundwork.Schema.Generator/Groundwork.Schema.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
