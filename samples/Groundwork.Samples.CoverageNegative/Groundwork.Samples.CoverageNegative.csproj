<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Groundwork.Schema/Groundwork.Schema.csproj" />
    <ProjectReference Include="../../src/Groundwork.Analyzers/Groundwork.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Groundwork.SchemaTool.MSBuild/Groundwork.SchemaTool.MSBuild.csproj"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="groundwork.schema.json" />
  </ItemGroup>
  <UsingTask TaskName="Groundwork.SchemaTool.MSBuild.GroundworkVerify"
             AssemblyFile="../../src/Groundwork.SchemaTool.MSBuild/bin/$(Configuration)/net10.0/Groundwork.SchemaTool.MSBuild.dll" />
  <Target Name="VerifyGroundworkCoverage" BeforeTargets="CoreCompile">
    <GroundworkVerify SchemaFile="$(MSBuildProjectDirectory)/groundwork.schema.json"
                      CoverageFile="$(MSBuildProjectDirectory)/groundwork.coverage.json" />
  </Target>
</Project>
