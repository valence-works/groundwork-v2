<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Groundwork.Samples.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Groundwork.Extensions.DependencyInjection/Groundwork.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Groundwork.Records.Store/Groundwork.Records.Store.csproj" />
    <!-- One reference per provider the sample can switch to at run time. An application that ships a
         single provider references exactly one of these; the dependency injection package references
         none of them. -->
    <ProjectReference Include="../../src/Groundwork.Sqlite/Groundwork.Sqlite.csproj" />
    <ProjectReference Include="../../src/Groundwork.PostgreSql/Groundwork.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Groundwork.SqlServer/Groundwork.SqlServer.csproj" />
    <ProjectReference Include="../../src/Groundwork.MongoDb/Groundwork.MongoDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Groundwork.Samples.Api.Tests" />
  </ItemGroup>

</Project>
