    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Groundwork.MongoDb</PackageId>
    <Description>Native typed-column MongoDB provider for Groundwork.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Substrate.Mongo/Groundwork.Substrate.Mongo.csproj" />
    <ProjectReference Include="../Groundwork.Store/Groundwork.Store.csproj" />
    <ProjectReference Include="../Groundwork.Diagnostics/Groundwork.Diagnostics.csproj" />
    <ProjectReference Include="../Groundwork.Query.Model/Groundwork.Query.Model.csproj" />
  </ItemGroup>

</Project>
