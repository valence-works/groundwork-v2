<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(GroundworkRuntimeTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <PackageId>Groundwork.Query.Linq.Sqlite</PackageId>
    <Description>SQLite execution adapter for Groundwork's closed LINQ front-end.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Groundwork.Query.Linq/Groundwork.Query.Linq.csproj" />
    <ProjectReference Include="../Groundwork.Query.Linq.Execution/Groundwork.Query.Linq.Execution.csproj" />
    <ProjectReference Include="../Groundwork.Sqlite/Groundwork.Sqlite.csproj" />
    <ProjectReference Include="../Groundwork.Store/Groundwork.Store.csproj" />
  </ItemGroup>
</Project>
