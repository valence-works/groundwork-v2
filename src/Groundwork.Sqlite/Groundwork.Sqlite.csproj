<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(GroundworkRuntimeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <PackageId>Groundwork.Sqlite</PackageId>
    <Description>SQLite provider for Groundwork typed storage.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override Microsoft.Data.Sqlite's vulnerable 2.1.11 native bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Store/Groundwork.Store.csproj" />
    <ProjectReference Include="../Groundwork.Diagnostics/Groundwork.Diagnostics.csproj" />
    <ProjectReference Include="../Groundwork.Substrate.Relational/Groundwork.Substrate.Relational.csproj" />
    <ProjectReference Include="../Groundwork.Query.Model/Groundwork.Query.Model.csproj" />
  </ItemGroup>

</Project>
