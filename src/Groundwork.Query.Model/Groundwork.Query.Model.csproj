<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Groundwork.Query.Model</RootNamespace>
    <AssemblyName>Groundwork.Query.Model</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Groundwork.Query.Model</PackageId>
    <Description>Provider-neutral query model and portable query value types for Groundwork.</Description>
    <PackageReadmeFile>Groundwork.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/v2/package-readme.md" Pack="true" PackagePath="Groundwork.md" />
    <PackageReference Include="System.Collections.Immutable" />
    <Compile Include="../Groundwork.Kernel/PortableSearchKeyEncoding.cs" Link="PortableSearchKeyEncoding.cs" />
    <Compile Include="../Groundwork.Kernel/UnicodeOrdinalCasingData.Generated.cs" Link="UnicodeOrdinalCasingData.Generated.cs" />
  </ItemGroup>
</Project>
