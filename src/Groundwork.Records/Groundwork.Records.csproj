<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(GroundworkRuntimeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Groundwork.Records</PackageId>
    <Description>Typed record declarations, optimistic concurrency, and query/write helpers for Groundwork.</Description>
    <PackageReadmeFile>Groundwork.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Query.Linq/Groundwork.Query.Linq.csproj" />
    <None Include="../../docs/v2/package-readme.md" Pack="true" PackagePath="Groundwork.md" />
  </ItemGroup>

</Project>
