<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Groundwork.Query.Planning</RootNamespace>
    <AssemblyName>Groundwork.Query.Planning</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Groundwork.Query.Planning</PackageId>
    <Description>Provider-neutral query planning, coverage, and portability validation for Groundwork.</Description>
    <PackageReadmeFile>Groundwork.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Groundwork.Query.Model/Groundwork.Query.Model.csproj" />
    <PackageReference Include="System.Collections.Immutable" />
    <None Include="../../docs/v2/package-readme.md" Pack="true" PackagePath="Groundwork.md" />
  </ItemGroup>
</Project>
