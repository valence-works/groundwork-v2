<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Groundwork.Extensions.DependencyInjection</PackageId>
    <Description>Dependency injection and hosting integration for Groundwork typed storage: named connections, the process-singleton connection lifetime, startup schema admission, and health checks.</Description>
    <PackageReadmeFile>Groundwork.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Store/Groundwork.Store.csproj" />
    <None Include="../../docs/v2/package-readme.md" Pack="true" PackagePath="Groundwork.md" />
  </ItemGroup>

</Project>
