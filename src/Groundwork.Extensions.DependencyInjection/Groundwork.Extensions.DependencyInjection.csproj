<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(GroundworkRuntimeTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <PackageId>Groundwork.Extensions.DependencyInjection</PackageId>
    <Description>Dependency injection and hosting integration for Groundwork typed storage: named connections, the process-singleton connection lifetime, startup schema admission, and health checks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Store/Groundwork.Store.csproj" />
  </ItemGroup>

</Project>
