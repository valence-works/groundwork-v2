<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(GroundworkRuntimeTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>groundwork</ToolCommandName>
    <PackageId>Groundwork.Tool</PackageId>
    <Description>Explicit deployment-time schema planning, validation, application, and emission for Groundwork.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Groundwork.Kernel/Groundwork.Kernel.csproj" />
    <ProjectReference Include="../Groundwork.Query.Model/Groundwork.Query.Model.csproj" />
    <ProjectReference Include="../Groundwork.Query.Planning/Groundwork.Query.Planning.csproj" />
    <ProjectReference Include="../Groundwork.Schema/Groundwork.Schema.csproj" />
    <ProjectReference Include="../Groundwork.MongoDb/Groundwork.MongoDb.csproj" />
    <ProjectReference Include="../Groundwork.MySql/Groundwork.MySql.csproj" />
    <ProjectReference Include="../Groundwork.PostgreSql/Groundwork.PostgreSql.csproj" />
    <ProjectReference Include="../Groundwork.SqlServer/Groundwork.SqlServer.csproj" />
    <ProjectReference Include="../Groundwork.Sqlite/Groundwork.Sqlite.csproj" />
  </ItemGroup>
</Project>
