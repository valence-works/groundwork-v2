<Project>
  <PropertyGroup>
    <!-- The single source of truth for what Groundwork targets. Projects write one of these two
         properties, or netstandard2.0, and never a literal framework of their own, so the set cannot
         drift apart per project. Groundwork.Packaging.Tests enforces the split.

           GroundworkRuntimeTargetFrameworks  the runtime packages an application references, plus
                                              every test suite that exercises them.
           GroundworkBuildTaskTargetFramework the MSBuild verification task, which loads into the
                                              SDK's own MSBuild process rather than into the
                                              consumer's application. Microsoft.Build 18.x does not
                                              support net8.0, so this one cannot follow the runtime
                                              set and deliberately does not.

         Portable contract, analyzer, and source-generator assemblies stay netstandard2.0. -->
    <GroundworkRuntimeTargetFrameworks>net8.0;net10.0</GroundworkRuntimeTargetFrameworks>
    <GroundworkBuildTaskTargetFramework>net10.0</GroundworkBuildTaskTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
    <!-- The most recently published release. Documentation pins this version, and
         docs/v2/releases/<version>.md must exist. On release, bump this together with
         VersionPrefix/VersionSuffix above; Groundwork.Packaging.Tests enforces consistency. -->
    <GroundworkCurrentRelease>0.2.0-preview.1</GroundworkCurrentRelease>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/valence-works/groundwork-v2</PackageProjectUrl>
    <RepositoryUrl>https://github.com/valence-works/groundwork-v2.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>groundwork;storage;typed-storage;provider-neutral</PackageTags>
    <PackageReleaseNotes>See https://github.com/valence-works/groundwork-v2/blob/main/docs/v2/versioning.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Valence Works</Authors>
    <Company>Valence Works</Company>
    <Copyright>Copyright © 2026 Valence Works</Copyright>
  </PropertyGroup>
</Project>
